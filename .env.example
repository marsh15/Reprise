# Required. Server-side only; never prefix secrets with VITE_.
LLM_API_KEY=
TAVILY_API_KEY=

# OpenAI-compatible Chat Completions endpoint and model (bake-off in M2).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
# Optional: none, low, medium, high. Leave unset unless supported by your model.
# LLM_REASONING_EFFORT=low

PORT=5173
REPRISE_DB_PATH=./data/reprise.db
# debug, info, warn, error
LOG_LEVEL=info
# Tests and evaluations only. Leave unset for real conversations.
# REPRISE_NOW=2026-11-03T10:00:00+05:30
