# Required. Server-side only; never prefix secrets with VITE_.
LLM_API_KEY=
TAVILY_API_KEY=

# OpenAI-compatible Chat Completions endpoint. Provisional model; live comparison pending.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
# Optional: none, low, medium, high. Luna tools on Chat Completions require none
# (applied automatically when unset). Terra tools require Responses and cannot run here.
# LLM_REASONING_EFFORT=none

PORT=5173
REPRISE_DB_PATH=./data/reprise.db
# debug, info, warn, error
LOG_LEVEL=info
# Tests and evaluations only. Leave unset for real conversations.
# REPRISE_NOW=2026-11-03T10:00:00+05:30

# Evaluation-only optional key; never sent to the application/browser.
# OPENROUTER_API_KEY=
