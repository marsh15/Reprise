      "boundElements": null,
      "updated": 1794661897588,
      "link": null,
      "locked": false,
      "text": "Request admission is browser-origin protection only. It\ndoes not authenticate local processes or other OS users.\nNon-API requests go to Vite (dev) or dist/ (production).",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Request admission is browser-origin protection only. It\ndoes not authenticate local processes or other OS users.\nNon-API requests go to Vite (dev) or dist/ (production).",
