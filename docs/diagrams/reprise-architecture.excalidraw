      "seed": 1803034197,
      "version": 2,
      "versionNonce": 1489759803,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794660379609,
      "link": null,
      "locked": false,
      "text": "The citation check is mechanical and bounded: it\nlooks for markers, numbers and dates in the cited\nexcerpt. It does not prove that a source\nsupports a claim.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The citation check is mechanical and bounded: it\nlooks for markers, numbers and dates in the cited\nexcerpt. It does not prove that a source\nsupports a claim.",
      "autoResize": true,
      "lineHeight": 1.15
    },
