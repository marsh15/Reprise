      "boundElements": null,
      "updated": 1794660379609,
      "link": null,
      "locked": false,
      "text": "What leaves this machine: recent messages, bounded\nrecalled context and source excerpts go to the configured\nLLM; search queries go to Tavily. Everything else stays\nin the local SQLite file.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What leaves this machine: recent messages, bounded\nrecalled context and source excerpts go to the configured\nLLM; search queries go to Tavily. Everything else stays\nin the local SQLite file.",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "n-check",
      "type": "text",
      "x": 850,
      "y": 868,
      "width": 328.4912109375,
      "height": 69,
      "angle": 0,
